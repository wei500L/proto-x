+package ackhandler
+
+import (
+	congestionExt "github.com/quic-go/quic-go/congestion"
+	"github.com/quic-go/quic-go/internal/monotime"
+	"github.com/quic-go/quic-go/internal/protocol"
+)
+
+// SetCongestionControl must only be called from the owning connection's event
+// loop. The caller has checked that cc is non-nil and was freshly constructed.
+func (h *sentPacketHandler) SetCongestionControl(cc congestionExt.CongestionControl, size protocol.ByteCount) {
+	cc.SetRTTStatsProvider(h.rttStats)
+	cc.SetMaxDatagramSize(congestionExt.ByteCount(size))
+	a := &ccAdapter{CC: cc, stats: h.connStats}
+	a.updateStats()
+	h.congestion = a
+	h.congestionBatch, _ = cc.(congestionExt.CongestionControlEx)
+	h.congestionAcked = h.congestionAcked[:0]
+	h.congestionLost = h.congestionLost[:0]
+	// The imported batch algorithms have no ECN response. Do not mark packets
+	// as ECN-capable when the selected controller cannot react to CE signals.
+	// This prototype intentionally has no custom-CC opt-in to ECN.
+	h.enableECN = false
+	h.ecnTracker = nil
+	h.qlogRecoveryParametersSet(true)
+}
+
+func (h *sentPacketHandler) reportCongestionBatch(priorInFlight protocol.ByteCount, now monotime.Time, acked []packetWithPacketNumber) {
+	if h.congestionBatch == nil {
+		return
+	}
+	for _, p := range acked {
+		if p.includedInBytesInFlight {
+			h.congestionAcked = append(h.congestionAcked, congestionExt.AckedPacketInfo{
+				PacketNumber: congestionExt.PacketNumber(p.PacketNumber),
+				BytesAcked:   congestionExt.ByteCount(p.Length),
+				ReceivedTime: now,
+			})
+		}
+	}
+	if len(h.congestionAcked) != 0 || len(h.congestionLost) != 0 {
+		h.congestionBatch.OnCongestionEventEx(congestionExt.ByteCount(priorInFlight), now, h.congestionAcked, h.congestionLost)
+		h.connStats.CongestionWindow.Store(uint64(max(0, h.congestion.GetCongestionWindow())))
+	}
+	h.congestionAcked = h.congestionAcked[:0]
+	h.congestionLost = h.congestionLost[:0]
+}
