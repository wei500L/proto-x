@@ -0,0 +1,194 @@
+package ackhandler
+
+import (
+	"fmt"
+	"slices"
+	"testing"
+	"time"
+
+	cc "github.com/quic-go/quic-go/congestion"
+	"github.com/quic-go/quic-go/internal/monotime"
+	"github.com/quic-go/quic-go/internal/protocol"
+	"github.com/quic-go/quic-go/internal/utils"
+	"github.com/quic-go/quic-go/internal/wire"
+	"github.com/stretchr/testify/require"
+)
+
+type congestionBatchRecord struct {
+	prior cc.ByteCount
+	time  monotime.Time
+	acked []cc.AckedPacketInfo
+	lost  []cc.LostPacketInfo
+}
+
+type externalRecorder struct {
+	batches  []congestionBatchRecord
+	order    []string
+	size     cc.ByteCount
+	provider cc.RTTStatsProvider
+}
+
+func (c *externalRecorder) SetRTTStatsProvider(p cc.RTTStatsProvider) { c.provider = p }
+func (*externalRecorder) TimeUntilSend(cc.ByteCount) monotime.Time    { return 0 }
+func (*externalRecorder) HasPacingBudget(monotime.Time) bool          { return true }
+func (*externalRecorder) OnPacketSent(monotime.Time, cc.ByteCount, cc.PacketNumber, cc.ByteCount, bool) {
+}
+func (*externalRecorder) CanSend(cc.ByteCount) bool                                                { return true }
+func (*externalRecorder) MaybeExitSlowStart()                                                      {}
+func (*externalRecorder) OnPacketAcked(cc.PacketNumber, cc.ByteCount, cc.ByteCount, monotime.Time) {}
+func (c *externalRecorder) OnCongestionEvent(pn cc.PacketNumber, _, _ cc.ByteCount) {
+	c.order = append(c.order, fmt.Sprintf("loss:%d", pn))
+}
+func (c *externalRecorder) OnSpuriousLoss(pn cc.PacketNumber) {
+	c.order = append(c.order, fmt.Sprintf("spurious:%d", pn))
+}
+func (*externalRecorder) OnRetransmissionTimeout(bool)           {}
+func (c *externalRecorder) SetMaxDatagramSize(size cc.ByteCount) { c.size = size }
+func (*externalRecorder) InSlowStart() bool                      { return false }
+func (*externalRecorder) InRecovery() bool                       { return false }
+func (c *externalRecorder) GetCongestionWindow() cc.ByteCount {
+	return 32*c.size + cc.ByteCount(len(c.batches))
+}
+func (c *externalRecorder) OnCongestionEventEx(prior cc.ByteCount, now monotime.Time, acked []cc.AckedPacketInfo, lost []cc.LostPacketInfo) {
+	c.order = append(c.order, "batch")
+	c.batches = append(c.batches, congestionBatchRecord{prior, now, slices.Clone(acked), slices.Clone(lost)})
+}
+
+func newExternalHandler(t *testing.T) (*sentPacketHandler, *externalRecorder) {
+	t.Helper()
+	h := NewSentPacketHandler(0, 1200, utils.NewRTTStats(), &utils.ConnectionStats{}, true, true, nil,
+		protocol.PerspectiveClient, nil, utils.DefaultLogger).(*sentPacketHandler)
+	h.handshakeConfirmed = true
+	require.NotEqual(t, protocol.ECNUnsupported, h.ECNMode(true))
+	c := &externalRecorder{}
+	h.SetCongestionControl(c, 1200)
+	require.Same(t, h.rttStats, c.provider)
+	require.Equal(t, cc.ByteCount(1200), c.size)
+	require.Equal(t, protocol.ECNUnsupported, h.ECNMode(true))
+	return h, c
+}
+
+func sendExternal(h *sentPacketHandler, now monotime.Time, size protocol.ByteCount, kind string) protocol.PacketNumber {
+	pn := h.PopPacketNumber(protocol.PacketNumberSpaceAppData)
+	var frames []Frame
+	if kind != "ack-only" {
+		frames = []Frame{{Frame: &wire.PingFrame{}}}
+	}
+	h.SentPacket(now, pn, protocol.InvalidPacketNumber, nil, frames, protocol.Encryption1RTT, protocol.ECNNon, size, kind == "mtu", kind == "path")
+	return pn
+}
+
+func ackExternal(t *testing.T, h *sentPacketHandler, now monotime.Time, pns ...protocol.PacketNumber) {
+	t.Helper()
+	_, err := h.ReceivedAck(&wire.AckFrame{AckRanges: ackRanges(pns...)}, protocol.Encryption1RTT, now)
+	require.NoError(t, err)
+}
+
+func TestExternalCongestionACKLossAndDuplicates(t *testing.T) {
+	h, c := newExternalHandler(t)
+	now := monotime.Now()
+	pns := make([]protocol.PacketNumber, 5)
+	for i := range pns {
+		pns[i] = sendExternal(h, now, 1000, "data")
+	}
+	ackTime := now.Add(100 * time.Millisecond)
+	ackExternal(t, h, ackTime, pns[0], pns[4])
+	require.Len(t, c.batches, 1)
+	require.Equal(t, congestionBatchRecord{
+		prior: 5000, time: ackTime,
+		acked: []cc.AckedPacketInfo{{PacketNumber: cc.PacketNumber(pns[0]), BytesAcked: 1000, ReceivedTime: ackTime}, {PacketNumber: cc.PacketNumber(pns[4]), BytesAcked: 1000, ReceivedTime: ackTime}},
+		lost:  []cc.LostPacketInfo{{PacketNumber: cc.PacketNumber(pns[1]), BytesLost: 1000}},
+	}, c.batches[0])
+	require.Equal(t, protocol.ByteCount(2000), h.bytesInFlight)
+	require.Equal(t, uint64(c.GetCongestionWindow()), h.connStats.CongestionWindow.Load())
+	ackExternal(t, h, ackTime, pns[0], pns[4])
+	require.Len(t, c.batches, 1, "duplicate ACK must not duplicate delivery or loss accounting")
+	_, err := h.ReceivedAck(&wire.AckFrame{AckRanges: ackRanges(pns[4] + 100)}, protocol.Encryption1RTT, ackTime)
+	require.Error(t, err)
+	require.Len(t, c.batches, 1)
+	ackExternal(t, h, ackTime, pns[2], pns[3])
+	require.Len(t, c.batches, 2)
+	require.Empty(t, c.batches[1].lost, "previous loss batch must not leak into the next event")
+	require.Equal(t, cc.ByteCount(2000), c.batches[1].prior)
+	require.Zero(t, h.bytesInFlight)
+}
+
+func TestExternalCongestionTimerOnlyLoss(t *testing.T) {
+	h, c := newExternalHandler(t)
+	now := monotime.Now()
+	p0 := sendExternal(h, now, 1000, "data")
+	p1 := sendExternal(h, now, 1000, "data")
+	ackExternal(t, h, now.Add(100*time.Millisecond), p1)
+	require.Len(t, c.batches, 1)
+	require.Empty(t, c.batches[0].lost)
+	timeout := h.GetLossDetectionTimeout()
+	require.False(t, timeout.IsZero())
+	require.NoError(t, h.OnLossDetectionTimeout(timeout))
+	require.Len(t, c.batches, 2)
+	require.Equal(t, cc.ByteCount(1000), c.batches[1].prior)
+	require.Equal(t, timeout, c.batches[1].time)
+	require.Empty(t, c.batches[1].acked)
+	require.Equal(t, []cc.LostPacketInfo{{PacketNumber: cc.PacketNumber(p0), BytesLost: 1000}}, c.batches[1].lost)
+	require.Zero(t, h.bytesInFlight)
+	require.NoError(t, h.OnLossDetectionTimeout(timeout.Add(time.Millisecond)))
+	require.Len(t, c.batches, 2, "stale timer must not duplicate losses")
+}
+
+func TestExternalCongestionSpuriousOnlyACKCanAlsoCauseLoss(t *testing.T) {
+	h, c := newExternalHandler(t)
+	now := monotime.Now()
+	p0 := sendExternal(h, now, 1000, "data")
+	p1 := sendExternal(h, now.Add(100*time.Millisecond), 1000, "data")
+	p2 := sendExternal(h, now.Add(100*time.Millisecond), 1000, "data")
+	ackExternal(t, h, now.Add(200*time.Millisecond), p2)
+	require.Len(t, c.batches, 1)
+	require.Equal(t, []cc.LostPacketInfo{{PacketNumber: cc.PacketNumber(p0), BytesLost: 1000}}, c.batches[0].lost)
+	c.order = nil
+	// This ACK newly acknowledges no outstanding packet. Spurious-loss
+	// adaptation also runs loss detection, which now declares p1 lost.
+	ackExternal(t, h, now.Add(250*time.Millisecond), p0)
+	require.Len(t, c.batches, 2)
+	require.Empty(t, c.batches[1].acked)
+	require.Equal(t, cc.ByteCount(1000), c.batches[1].prior)
+	require.Equal(t, []cc.LostPacketInfo{{PacketNumber: cc.PacketNumber(p1), BytesLost: 1000}}, c.batches[1].lost)
+	require.Equal(t, []string{fmt.Sprintf("loss:%d", p1), "batch", fmt.Sprintf("spurious:%d", p0)}, c.order)
+	require.True(t, h.packetThresholdDisabled)
+	require.Equal(t, uint8(2), h.timeThresholdEighths)
+	ackExternal(t, h, now.Add(260*time.Millisecond), p1)
+	require.Len(t, c.batches, 2, "pure spurious ACK must not create an empty batch")
+	require.Zero(t, h.bytesInFlight)
+}
+
+func TestExternalCongestionProbeAccounting(t *testing.T) {
+	h, c := newExternalHandler(t)
+	now := monotime.Now()
+	mtu := sendExternal(h, now, 1400, "mtu")
+	path := sendExternal(h, now, 1200, "path")
+	ackOnly := sendExternal(h, now, 100, "ack-only")
+	data := sendExternal(h, now.Add(100*time.Millisecond), 1000, "data")
+	ackExternal(t, h, now.Add(200*time.Millisecond), data)
+	require.Len(t, c.batches, 1)
+	require.Equal(t, cc.ByteCount(2400), c.batches[0].prior)
+	require.Equal(t, []cc.LostPacketInfo{{PacketNumber: cc.PacketNumber(mtu), BytesLost: 1400, IsMTUProbe: true}}, c.batches[0].lost)
+	require.Equal(t, []string{"batch"}, c.order, "MTU loss must not invoke ordinary per-packet congestion callback")
+	require.Zero(t, h.bytesInFlight)
+	ackExternal(t, h, now.Add(210*time.Millisecond), path, ackOnly)
+	require.Len(t, c.batches, 1, "path-validation and ACK-only packets are not in-flight data")
+}
+
+func TestExternalCongestionMigrationClearsOldBatch(t *testing.T) {
+	h, c := newExternalHandler(t)
+	now := monotime.Now()
+	sendExternal(h, now, 1000, "data")
+	h.MigratedPath(now.Add(time.Millisecond), 1200)
+	require.Nil(t, h.congestionBatch)
+	require.Zero(t, h.bytesInFlight)
+	next := &externalRecorder{}
+	h.SetCongestionControl(next, 1200)
+	p := sendExternal(h, now.Add(2*time.Millisecond), 1200, "data")
+	ackExternal(t, h, now.Add(100*time.Millisecond), p)
+	require.Empty(t, c.batches)
+	require.Len(t, next.batches, 1)
+	require.Empty(t, next.batches[0].lost)
+	require.Equal(t, cc.ByteCount(1200), next.batches[0].prior)
+}
