diff --git a/congestion/interface.go b/congestion/interface.go
new file mode 100644
index 0000000..5e969a3
--- /dev/null
+++ b/congestion/interface.go
@@ -0,0 +1,96 @@
+// Package congestion is an experimental extension for externally implemented
+// congestion controllers. It is not part of upstream quic-go's public API.
+package congestion
+
+import (
+	"time"
+
+	"github.com/quic-go/quic-go/internal/protocol"
+	"github.com/quic-go/quic-go/monotime"
+)
+
+type (
+	ByteCount    protocol.ByteCount
+	PacketNumber protocol.PacketNumber
+)
+
+// Expose some constants from protocol that congestion control algorithms may need.
+const (
+	InitialPacketSize = protocol.InitialPacketSize
+	// MinPacingDelay preserves the 1 ms pacing floor used by the Hysteria
+	// controller sources. Upstream moved its equivalent constant in v0.64.
+	MinPacingDelay             = time.Millisecond
+	MaxPacketBufferSize        = protocol.MaxPacketBufferSize
+	MinInitialPacketSize       = protocol.MinInitialPacketSize
+	MaxCongestionWindowPackets = protocol.MaxCongestionWindowPackets
+	PacketsPerConnectionID     = protocol.PacketsPerConnectionID
+)
+
+type AckedPacketInfo struct {
+	PacketNumber PacketNumber
+	BytesAcked   ByteCount
+	// ReceivedTime is the local time at which the ACK was received, not the
+	// receiver's packet arrival time.
+	ReceivedTime monotime.Time
+}
+
+type LostPacketInfo struct {
+	PacketNumber PacketNumber
+	BytesLost    ByteCount
+	// IsMTUProbe marks loss from a PMTU probe. Such loss is included in batch
+	// accounting but does not invoke the single-packet congestion callback.
+	IsMTUProbe bool
+}
+
+// Factory creates a fresh controller for a connection or a newly active path.
+// The controller must be seeded at or below maxDatagramSize. The factory and
+// controller callbacks run on the connection event loop; they must not block,
+// call Conn methods synchronously, or retain callback slices / RTT providers
+// for access from another goroutine. A controller must belong to one Conn only.
+// Factories may also be called after a decrease in the permitted datagram size.
+type Factory func(maxDatagramSize ByteCount) (CongestionControl, error)
+
+// SpuriousLossAware optionally rolls back the effect of a loss declaration.
+// Controllers that do not implement it receive no rollback notification.
+type SpuriousLossAware interface {
+	OnSpuriousLoss(PacketNumber)
+}
+
+type CongestionControl interface {
+	SetRTTStatsProvider(provider RTTStatsProvider)
+	TimeUntilSend(bytesInFlight ByteCount) monotime.Time
+	HasPacingBudget(now monotime.Time) bool
+	OnPacketSent(sentTime monotime.Time, bytesInFlight ByteCount, packetNumber PacketNumber, bytes ByteCount, isRetransmittable bool)
+	CanSend(bytesInFlight ByteCount) bool
+	MaybeExitSlowStart()
+	OnPacketAcked(number PacketNumber, ackedBytes ByteCount, priorInFlight ByteCount, eventTime monotime.Time)
+	OnCongestionEvent(number PacketNumber, lostBytes ByteCount, priorInFlight ByteCount)
+	OnRetransmissionTimeout(packetsRetransmitted bool)
+	SetMaxDatagramSize(size ByteCount)
+	InSlowStart() bool
+	InRecovery() bool
+	GetCongestionWindow() ByteCount
+}
+
+type CongestionControlEx interface {
+	CongestionControl
+	// OnCongestionEventEx is called once per nonempty ACK/loss event, including
+	// timer-only loss. ACKs include only newly removed in-flight packets. Losses
+	// include PMTU probes, but never path-validation probes. The slices are
+	// borrowed until this call returns. Spurious-loss callbacks follow this
+	// batch. Per-packet callbacks still run: an extended controller should not
+	// account the same bytes in both callback forms.
+	OnCongestionEventEx(priorInFlight ByteCount, eventTime monotime.Time, ackedPackets []AckedPacketInfo, lostPackets []LostPacketInfo)
+}
+
+type RTTStatsProvider interface {
+	MinRTT() time.Duration
+	LatestRTT() time.Duration
+	SmoothedRTT() time.Duration
+	MeanDeviation() time.Duration
+	MaxAckDelay() time.Duration
+	PTO(includeMaxAckDelay bool) time.Duration
+	UpdateRTT(sendDelta, ackDelay time.Duration)
+	SetMaxAckDelay(mad time.Duration)
+	SetInitialRTT(t time.Duration)
+}
diff --git a/congestion_control.go b/congestion_control.go
new file mode 100644
index 0000000..f061c8d
--- /dev/null
+++ b/congestion_control.go
@@ -0,0 +1,100 @@
+package quic
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"reflect"
+
+	"github.com/quic-go/quic-go/congestion"
+	"github.com/quic-go/quic-go/internal/monotime"
+	"github.com/quic-go/quic-go/internal/protocol"
+)
+
+type congestionUpdate struct {
+	factory congestion.Factory
+	result  chan error
+}
+
+// SetCongestionControlFactory installs an experimental external controller.
+// It waits until the connection event loop has applied the update, or the
+// connection closes. Calls may be concurrent. The queue holds at most one
+// pending update; blocked callers must not hold resources needed by the Conn.
+// The factory also creates a fresh controller after native path migration or
+// a reduction of the datagram size, so neither silently restores default Reno.
+// A factory failure during those resets closes the connection.
+//
+// Calling this method does not authenticate a peer. Applications should wait
+// for their own authentication before installing resource-intensive senders.
+// Factories and controllers run on the event loop and must follow the lifetime
+// and nonblocking requirements of congestion.Factory. Custom controllers
+// disable outgoing ECN in this research extension. This API is not upstream.
+func (c *Conn) SetCongestionControlFactory(factory congestion.Factory) error {
+	if factory == nil {
+		return errors.New("nil congestion control factory")
+	}
+	if err := context.Cause(c.ctx); err != nil {
+		return err
+	}
+	request := congestionUpdate{factory: factory, result: make(chan error, 1)}
+	select {
+	case c.congestionUpdates <- request:
+	case <-c.ctx.Done():
+		return context.Cause(c.ctx)
+	}
+	select {
+	case err := <-request.result:
+		return err
+	case <-c.ctx.Done():
+		return context.Cause(c.ctx)
+	}
+}
+
+// All methods below execute exclusively on the connection event loop.
+func (c *Conn) applyCongestionUpdate(request congestionUpdate) {
+	request.result <- c.installCongestionFactory(request.factory, c.maxPacketSize())
+}
+
+func (c *Conn) installCongestionFactory(factory congestion.Factory, size protocol.ByteCount) error {
+	cc, err := factory(congestion.ByteCount(size))
+	if err != nil {
+		return fmt.Errorf("create congestion controller: %w", err)
+	}
+	if cc == nil {
+		return errors.New("congestion control factory returned nil")
+	}
+	// A typed nil is non-nil when stored in an interface.
+	v := reflect.ValueOf(cc)
+	switch v.Kind() {
+	case reflect.Chan, reflect.Func, reflect.Interface, reflect.Map, reflect.Pointer, reflect.Slice:
+		if v.IsNil() {
+			return errors.New("congestion control factory returned typed nil")
+		}
+	}
+	c.sentPacketHandler.SetCongestionControl(cc, size)
+	c.congestionFactory = factory
+	c.congestionDatagramSize = size
+	c.pacingDeadline = deadlineSendImmediately
+	return nil
+}
+
+func (c *Conn) migrateCongestionPath(now monotime.Time, size protocol.ByteCount) error {
+	c.sentPacketHandler.MigratedPath(now, size)
+	if c.congestionFactory == nil {
+		return nil
+	}
+	return c.installCongestionFactory(c.congestionFactory, size)
+}
+
+func (c *Conn) setCongestionDatagramSize(size protocol.ByteCount) error {
+	if c.congestionFactory != nil && size < c.congestionDatagramSize {
+		// Some imported controllers panic on a size decrease. A fresh controller
+		// keeps the upstream Initial-size fallback usable without editing them.
+		return c.installCongestionFactory(c.congestionFactory, size)
+	}
+	c.sentPacketHandler.SetMaxDatagramSize(size)
+	if c.congestionFactory != nil {
+		c.congestionDatagramSize = size
+	}
+	return nil
+}
diff --git a/congestion_control_test.go b/congestion_control_test.go
new file mode 100644
index 0000000..3d66ecb
--- /dev/null
+++ b/congestion_control_test.go
@@ -0,0 +1,170 @@
+package quic
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/quic-go/quic-go/congestion"
+	"github.com/quic-go/quic-go/internal/ackhandler"
+	"github.com/quic-go/quic-go/internal/monotime"
+	"github.com/quic-go/quic-go/internal/protocol"
+	"github.com/quic-go/quic-go/internal/utils"
+	"github.com/stretchr/testify/require"
+)
+
+type factoryTestController struct {
+	size congestion.ByteCount
+	rtt  congestion.RTTStatsProvider
+}
+
+func (c *factoryTestController) SetRTTStatsProvider(rtt congestion.RTTStatsProvider) { c.rtt = rtt }
+func (*factoryTestController) TimeUntilSend(congestion.ByteCount) monotime.Time      { return 0 }
+func (*factoryTestController) HasPacingBudget(monotime.Time) bool                    { return true }
+func (*factoryTestController) OnPacketSent(monotime.Time, congestion.ByteCount, congestion.PacketNumber, congestion.ByteCount, bool) {
+}
+func (*factoryTestController) CanSend(congestion.ByteCount) bool { return true }
+func (*factoryTestController) MaybeExitSlowStart()               {}
+func (*factoryTestController) OnPacketAcked(congestion.PacketNumber, congestion.ByteCount, congestion.ByteCount, monotime.Time) {
+}
+func (*factoryTestController) OnCongestionEvent(congestion.PacketNumber, congestion.ByteCount, congestion.ByteCount) {
+}
+func (*factoryTestController) OnRetransmissionTimeout(bool) {}
+func (c *factoryTestController) SetMaxDatagramSize(size congestion.ByteCount) {
+	if size < c.size {
+		panic("legacy controller cannot decrease MTU")
+	}
+	c.size = size
+}
+func (*factoryTestController) InSlowStart() bool                           { return false }
+func (*factoryTestController) InRecovery() bool                            { return false }
+func (c *factoryTestController) GetCongestionWindow() congestion.ByteCount { return 32 * c.size }
+
+func newFactoryTestConn(t *testing.T) *Conn {
+	t.Helper()
+	ctx, cancel := context.WithCancelCause(context.Background())
+	t.Cleanup(func() { cancel(context.Canceled) })
+	c := &Conn{ctx: ctx, ctxCancel: cancel, congestionUpdates: make(chan congestionUpdate, 1),
+		config: populateConfig(&Config{}), perspective: protocol.PerspectiveClient,
+		rttStats: utils.NewRTTStats()}
+	c.sentPacketHandler = ackhandler.NewSentPacketHandler(0, 1280, c.rttStats, &c.connStats, true, true,
+		nil, protocol.PerspectiveClient, nil, utils.DefaultLogger)
+	return c
+}
+
+func TestCongestionFactoryRejectsInvalidControllerWithoutReplacement(t *testing.T) {
+	c := newFactoryTestConn(t)
+	require.Error(t, c.SetCongestionControlFactory(nil))
+	require.Nil(t, c.congestionFactory)
+	for _, factory := range []congestion.Factory{
+		func(congestion.ByteCount) (congestion.CongestionControl, error) {
+			return nil, errors.New("factory failure")
+		},
+		func(congestion.ByteCount) (congestion.CongestionControl, error) { return nil, nil },
+		func(congestion.ByteCount) (congestion.CongestionControl, error) {
+			var cc *factoryTestController
+			return cc, nil
+		},
+	} {
+		require.Error(t, c.installCongestionFactory(factory, 1200))
+		require.Nil(t, c.congestionFactory)
+		require.Zero(t, c.congestionDatagramSize)
+	}
+	valid := func(size congestion.ByteCount) (congestion.CongestionControl, error) {
+		return &factoryTestController{size: size}, nil
+	}
+	require.NoError(t, c.installCongestionFactory(valid, 1200))
+	require.Error(t, c.installCongestionFactory(func(congestion.ByteCount) (congestion.CongestionControl, error) { return nil, nil }, 1500))
+	require.Equal(t, protocol.ByteCount(1200), c.congestionDatagramSize)
+	require.Equal(t, uint64(32*1200), c.connStats.CongestionWindow.Load())
+}
+
+func TestCongestionFactoryFreshAfterMigrationAndMTUDecrease(t *testing.T) {
+	c := newFactoryTestConn(t)
+	var controllers []*factoryTestController
+	factory := func(size congestion.ByteCount) (congestion.CongestionControl, error) {
+		controller := &factoryTestController{size: size}
+		controllers = append(controllers, controller)
+		return controller, nil
+	}
+	require.NoError(t, c.installCongestionFactory(factory, 1280))
+	require.NoError(t, c.setCongestionDatagramSize(1450))
+	require.Len(t, controllers, 1)
+	require.Equal(t, congestion.ByteCount(1450), controllers[0].size)
+	require.NoError(t, c.setCongestionDatagramSize(1200))
+	require.Len(t, controllers, 2)
+	require.Equal(t, congestion.ByteCount(1450), controllers[0].size, "old controller must not see a decrease")
+	require.Equal(t, congestion.ByteCount(1200), controllers[1].size)
+	require.NoError(t, c.migrateCongestionPath(monotime.Now(), 1200))
+	require.NoError(t, c.migrateCongestionPath(monotime.Now(), 1200))
+	require.Len(t, controllers, 4, "each path reset must create its own instance")
+	for i, controller := range controllers {
+		require.Same(t, c.rttStats, controller.rtt)
+		if i > 0 {
+			require.NotSame(t, controllers[i-1], controller)
+		}
+	}
+	require.Equal(t, uint64(32*1200), c.connStats.CongestionWindow.Load())
+	require.Equal(t, protocol.ECNUnsupported, c.sentPacketHandler.ECNMode(true))
+}
+
+func TestCongestionFactoryResetReportsFailure(t *testing.T) {
+	for _, reset := range []string{"mtu", "path"} {
+		t.Run(reset, func(t *testing.T) {
+			c := newFactoryTestConn(t)
+			calls := 0
+			factory := func(size congestion.ByteCount) (congestion.CongestionControl, error) {
+				calls++
+				if calls > 1 {
+					return nil, errors.New("cannot create next controller")
+				}
+				return &factoryTestController{size: size}, nil
+			}
+			require.NoError(t, c.installCongestionFactory(factory, 1280))
+			var err error
+			if reset == "mtu" {
+				err = c.setCongestionDatagramSize(1200)
+			} else {
+				err = c.migrateCongestionPath(monotime.Now(), 1200)
+			}
+			require.ErrorContains(t, err, "cannot create next controller")
+			require.Equal(t, 2, calls)
+		})
+	}
+}
+
+func TestCongestionFactoryPendingSettersUnblockOnClose(t *testing.T) {
+	c := newFactoryTestConn(t)
+	const n = 32
+	var wg sync.WaitGroup
+	errorsCh := make(chan error, n)
+	for range n {
+		wg.Go(func() {
+			errorsCh <- c.SetCongestionControlFactory(func(size congestion.ByteCount) (congestion.CongestionControl, error) {
+				return &factoryTestController{size: size}, nil
+			})
+		})
+	}
+	// Taking the first request proves a setter is waiting for its result;
+	// the other callers can be queued or waiting for the bounded queue.
+	select {
+	case <-c.congestionUpdates:
+	case <-time.After(time.Second):
+		t.Fatal("setter did not queue")
+	}
+	want := errors.New("test connection closed")
+	c.ctxCancel(want)
+	finished := make(chan struct{})
+	go func() { wg.Wait(); close(finished) }()
+	select {
+	case <-finished:
+	case <-time.After(time.Second):
+		t.Fatal("setters blocked after close")
+	}
+	close(errorsCh)
+	for err := range errorsCh {
+		require.ErrorIs(t, err, want)
+	}
+}
