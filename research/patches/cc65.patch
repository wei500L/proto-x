+			highGain:                     defaultHighGain,
+			highCwndGain:                 derivedHighCWNDGain,
+			congestionWindowGainConstant: 2.0,
+			numStartupRtts:               roundTripsWithoutGrowthBeforeExitingStartup,
+			bytesLostMultiplier:          2,
+		}
+	}
+}
+
