+	hycc "proto-x/internal/hycc"
+)
+
+// These process-wide switches are intentionally confined to the research
+// worktree. Stable configuration, scheduler and session semantics are unchanged.
+type ccOptions struct {
+	mode                    string
+	profile                 string
+	bytesPerSecond          uint64
+	disableLossCompensation bool
+}
+
+func ccOptionsFromEnv() (*ccOptions, error) {
+	o := &ccOptions{mode: os.Getenv("PROTOX_CC")}
+	switch o.mode {
+	case "", "reno":
+		o.mode = "reno"
+	case "hy-bbr-standard":
+		o.profile = "standard"
+	case "hy-bbr-conservative":
+		o.profile = "conservative"
+	case "hy-bbr-aggressive":
+		o.profile = "aggressive"
+	case "hy-brutal":
+		rate, err := strconv.ParseFloat(os.Getenv("PROTOX_CC_BRUTAL_MBPS"), 64)
+		if err != nil || math.IsNaN(rate) || math.IsInf(rate, 0) || rate <= 0 || rate > 100000 {
+			return nil, errors.New("experimental Brutal requires PROTOX_CC_BRUTAL_MBPS in (0, 100000]")
+		}
+		o.bytesPerSecond = uint64(rate * 1e6 / 8)
+		if o.bytesPerSecond == 0 {
+			return nil, errors.New("experimental Brutal rate is below one byte per second")
+		}
+		if value := os.Getenv("PROTOX_CC_DISABLE_LOSS_COMPENSATION"); value != "" {
+			o.disableLossCompensation, err = strconv.ParseBool(value)
+			if err != nil {
+				return nil, errors.New("PROTOX_CC_DISABLE_LOSS_COMPENSATION must be boolean")
+			}
+		}
+	default:
+		return nil, errors.New("PROTOX_CC must be reno, hy-bbr-standard, hy-bbr-conservative, hy-bbr-aggressive, or hy-brutal")
+	}
+	return o, nil
+}
+
+// Start calls install only after the PROTO-X application authentication has
+// completed. Hysteria likewise replaces its controller after authentication.
+func (o *ccOptions) install(conn *quic.Conn) error {
+	var factory congestion.Factory
+	switch {
+	case o.mode == "hy-brutal":
+		factory = hycc.BrutalFactory(o.bytesPerSecond, o.disableLossCompensation)
+	case o.profile != "":
+		var err error
+		factory, err = hycc.BBRFactory(o.profile)
+		if err != nil {
+			return err
+		}
+	}
+	if factory != nil {
+		generation := 0 // all accesses are on this Conn's event loop
+		if err := conn.SetCongestionControlFactory(func(size congestion.ByteCount) (congestion.CongestionControl, error) {
+			cc, err := factory(size)
+			if err == nil {
+				generation++
+				slog.Info("experimental QUIC controller created", "controller", o.mode,
+					"generation", generation, "max_datagram_size", size, "quic_base", "v0.65.0")
+			}
+			return cc, err
+		}); err != nil {
+			return err
+		}
+	}
+	slog.Info("experimental QUIC controller installed", "controller", o.mode,
+		"quic_base", "v0.65.0",
+		"hysteria_source", "ca8fbd874fd6ca82413948de6dc5924405e103e1",
+		"brutal_bytes_per_second", o.bytesPerSecond,
+		"disable_loss_compensation", o.disableLossCompensation)
+	return nil
+}
diff --git a/internal/carrier/experimental_cc_test.go b/internal/carrier/experimental_cc_test.go
new file mode 100644
index 0000000..c88e6fc
--- /dev/null
+++ b/internal/carrier/experimental_cc_test.go
@@ -0,0 +1,229 @@
+package carrier
+
+import (
+	"bytes"
+	"context"
+	"crypto/ed25519"
+	"crypto/rand"
+	"crypto/tls"
+	"crypto/x509"
+	"errors"
+	"io"
+	"math/big"
+	"net"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	quic "github.com/quic-go/quic-go"
+	"github.com/quic-go/quic-go/congestion"
+	"github.com/stretchr/testify/require"
+	hycc "proto-x/internal/hycc"
+)
+
+type ccPair struct {
+	ctx            context.Context
+	client, server *quic.Conn
+	first, second  *quic.Transport
+}
+
+func newCCPair(t *testing.T) ccPair {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Second)
+	t.Cleanup(cancel)
+	pub, priv, err := ed25519.GenerateKey(rand.Reader)
+	require.NoError(t, err)
+	template := &x509.Certificate{SerialNumber: big.NewInt(1), NotBefore: time.Now().Add(-time.Minute), NotAfter: time.Now().Add(time.Hour), DNSNames: []string{"localhost"}}
+	der, err := x509.CreateCertificate(rand.Reader, template, template, pub, priv)
+	require.NoError(t, err)
+	ln, err := quic.ListenAddr("127.0.0.1:0", TLSConfig(tls.Certificate{Certificate: [][]byte{der}, PrivateKey: priv}), QUICConfig())
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = ln.Close() })
+	transport := func() *quic.Transport {
+		u, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+		require.NoError(t, err)
+		tr := &quic.Transport{Conn: u}
+		t.Cleanup(func() { _ = tr.Close(); _ = u.Close() })
+		return tr
+	}
+	tr1, tr2 := transport(), transport()
+	c, err := tr1.Dial(ctx, ln.Addr(), &tls.Config{MinVersion: tls.VersionTLS13, InsecureSkipVerify: true, NextProtos: []string{ALPN}}, QUICConfig())
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = c.CloseWithError(0, "test complete") })
+	s, err := ln.Accept(ctx)
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = s.CloseWithError(0, "test complete") })
+	return ccPair{ctx: ctx, client: c, server: s, first: tr1, second: tr2}
+}
+
+func ccFactoryForTest(t *testing.T, mode string) congestion.Factory {
+	t.Helper()
+	if mode == "brutal" {
+		return hycc.BrutalFactory(750000, false)
+	}
+	factory, err := hycc.BBRFactory(mode)
+	require.NoError(t, err)
+	return factory
+}
+
+func installCounted(t *testing.T, conn *quic.Conn, factory congestion.Factory, count *atomic.Int64) {
+	t.Helper()
+	require.NoError(t, conn.SetCongestionControlFactory(func(size congestion.ByteCount) (congestion.CongestionControl, error) {
+		cc, err := factory(size)
+		if err == nil {
+			count.Add(1)
+		}
+		return cc, err
+	}))
+}
+
+// startCCEcho returns one original bidirectional stream. All phases below use
+// that same stream while only QUIC's native path changes.
+func startCCEcho(t *testing.T, p ccPair) (*quic.Stream, <-chan error) {
+	t.Helper()
+	finished := make(chan error, 1)
+	go func() {
+		s, err := p.server.AcceptStream(p.ctx)
+		if err != nil {
+			finished <- err
+			return
+		}
+		_, err = io.Copy(s, s)
+		if closeErr := s.Close(); err == nil {
+			err = closeErr
+		}
+		finished <- err
+	}()
+	s, err := p.client.OpenStreamSync(p.ctx)
+	require.NoError(t, err)
+	require.NoError(t, s.SetDeadline(time.Now().Add(15*time.Second)))
+	return s, finished
+}
+
+func exchangeCC(t *testing.T, s *quic.Stream, phase, size int) {
+	t.Helper()
+	payload := make([]byte, size)
+	for i := range payload {
+		payload[i] = byte((i*71 + i/113 + phase*19) % 251)
+	}
+	written := make(chan error, 1)
+	go func() { _, err := s.Write(payload); written <- err }()
+	got := make([]byte, len(payload))
+	_, err := io.ReadFull(s, got)
+	require.NoError(t, err)
+	require.Equal(t, payload, got, "path changes must preserve ordered bytes exactly")
+	require.NoError(t, <-written)
+}
+
+func TestCC65NativeMigrationRetainsControllerAndOriginalStream(t *testing.T) {
+	for _, mode := range []string{"reno", "standard", "conservative", "aggressive", "brutal"} {
+		t.Run(mode, func(t *testing.T) {
+			p := newCCPair(t)
+			var clients, servers atomic.Int64
+			if mode != "reno" {
+				factory := ccFactoryForTest(t, mode)
+				installCounted(t, p.client, factory, &clients)
+				installCounted(t, p.server, factory, &servers)
+			}
+			s, finished := startCCEcho(t, p)
+			exchangeCC(t, s, 0, 256<<10)
+			for round, tr := range []*quic.Transport{p.second, p.first} {
+				path, err := p.client.AddPath(tr)
+				require.NoError(t, err)
+				require.NoError(t, path.Probe(p.ctx))
+				require.NoError(t, path.Switch())
+				exchangeCC(t, s, round+1, 256<<10)
+				require.Eventually(t, func() bool {
+					return p.client.LocalAddr().String() == tr.Conn.LocalAddr().String() && p.server.RemoteAddr().String() == tr.Conn.LocalAddr().String()
+				}, 2*time.Second, time.Millisecond)
+				if mode != "reno" {
+					require.GreaterOrEqual(t, clients.Load(), int64(round+2), "client must recreate selected controller")
+					require.GreaterOrEqual(t, servers.Load(), int64(round+2), "server must recreate selected controller")
+				}
+			}
+			require.NoError(t, s.Close())
+			extra, err := io.ReadAll(s)
+			require.NoError(t, err)
+			require.Empty(t, extra)
+			select {
+			case err := <-finished:
+				require.NoError(t, err)
+			case <-p.ctx.Done():
+				t.Fatal(context.Cause(p.ctx))
+			}
+			t.Logf("mode=%s exact_echo_bytes=%d native_path_changes=2 client_controllers=%d server_controllers=%d", mode, 3*(256<<10), clients.Load(), servers.Load())
+		})
+	}
+}
+
+func TestCC65ConcurrentSettersDuringTraffic(t *testing.T) {
+	p := newCCPair(t)
+	factory := ccFactoryForTest(t, "standard")
+	var clients, servers atomic.Int64
+	installCounted(t, p.client, factory, &clients)
+	installCounted(t, p.server, factory, &servers)
+	s, finished := startCCEcho(t, p)
+	errorsCh := make(chan error, 64)
+	var wg sync.WaitGroup
+	for i := range 8 {
+		conn := p.client
+		if i%2 == 1 {
+			conn = p.server
+		}
+		wg.Go(func() {
+			for range 8 {
+				errorsCh <- conn.SetCongestionControlFactory(factory)
+			}
+		})
+	}
+	exchangeCC(t, s, 42, 512<<10)
+	wg.Wait()
+	close(errorsCh)
+	for err := range errorsCh {
+		require.NoError(t, err)
+	}
+	require.NoError(t, s.Close())
+	extra, err := io.ReadAll(s)
+	require.NoError(t, err)
+	require.True(t, bytes.Equal(extra, []byte{}))
+	select {
+	case err := <-finished:
+		require.NoError(t, err)
+	case <-p.ctx.Done():
+		t.Fatal(context.Cause(p.ctx))
+	}
+}
+
+func TestCC65MigrationFactoryFailureClosesConnection(t *testing.T) {
+	for _, side := range []string{"client", "server"} {
+		t.Run(side, func(t *testing.T) {
+			p := newCCPair(t)
+			factory := ccFactoryForTest(t, "brutal")
+			conn := p.client
+			if side == "server" {
+				conn = p.server
+			}
+			var calls atomic.Int64
+			require.NoError(t, conn.SetCongestionControlFactory(func(size congestion.ByteCount) (congestion.CongestionControl, error) {
+				if calls.Add(1) > 1 {
+					return nil, errors.New("intentional migration factory failure")
+				}
+				return factory(size)
+			}))
+			s, _ := startCCEcho(t, p)
+			exchangeCC(t, s, 0, 4096)
+			path, err := p.client.AddPath(p.second)
+			require.NoError(t, err)
+			require.NoError(t, path.Probe(p.ctx))
+			require.NoError(t, path.Switch())
+			_, _ = s.Write([]byte("trigger non-probing packet on new path"))
+			select {
+			case <-conn.Context().Done():
+			case <-time.After(3 * time.Second):
+				t.Fatal("factory failure did not close the connection")
+			}
+			require.Equal(t, int64(2), calls.Load())
+		})
+	}
+}
