+// A bounded FIFO delay path for this test only. It does not inspect encrypted
+// payloads, add random losses, or claim to model a real network's performance.
+func delayedUDPPath(t *testing.T, target string, delay time.Duration) string {
+	t.Helper()
+	dst, err := net.ResolveUDPAddr("udp", target)
+	if err != nil {
+		t.Fatal(err)
+	}
+	front, err := net.ListenUDP("udp", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	back, err := net.DialUDP("udp", nil, dst)
+	if err != nil {
+		front.Close()
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	t.Cleanup(func() { cancel(); front.Close(); back.Close() })
+	type packet struct {
+		data []byte
+		due  time.Time
+	}
+	up, down := make(chan packet, 256), make(chan packet, 256)
+	var client *net.UDPAddr
+	var mu sync.Mutex
+	read := func(c *net.UDPConn, queue chan<- packet, upstream bool) {
+		buf := make([]byte, 65535)
+		for {
+			n, addr, err := c.ReadFromUDP(buf)
+			if err != nil {
+				return
+			}
+			if upstream {
+				mu.Lock()
+				client = addr
+				mu.Unlock()
+			}
+			p := packet{data: append([]byte(nil), buf[:n]...), due: time.Now().Add(delay)}
+			select {
+			case queue <- p:
+			case <-ctx.Done():
+				return
+			}
+		}
+	}
+	write := func(queue <-chan packet, upstream bool) {
+		for {
+			select {
+			case <-ctx.Done():
+				return
+			case p := <-queue:
+				timer := time.NewTimer(max(0, time.Until(p.due)))
+				select {
+				case <-ctx.Done():
+					timer.Stop()
+					return
+				case <-timer.C:
+				}
+				if upstream {
+					_, _ = back.Write(p.data)
+				} else {
+					mu.Lock()
+					addr := client
+					mu.Unlock()
+					if addr != nil {
+						_, _ = front.WriteToUDP(p.data, addr)
+					}
+				}
+			}
+		}
+	}
+	go read(front, up, true)
+	go read(back, down, false)
+	go write(up, true)
+	go write(down, false)
+	return front.LocalAddr().String()
+}
